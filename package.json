{
	"name": "personal-website",
	"version": "0.0.1",
	"private": true,
	"homepage": "https://NadzTiwing.github.io/nadia-tiwing",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
