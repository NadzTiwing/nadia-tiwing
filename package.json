		"gh-pages": "6.0.0",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "3.4.0",
		"prettier-plugin-tailwindcss": "0.7.2",
		"svelte": "^5.56.3",
		"svelte-check": "4.3.4",
		"tailwindcss": "4.1.17",
		"typescript": "5.9.3",
		"vite": "^7.3.5"
	},
	"keywords": [
		"svelte"
	]
}
